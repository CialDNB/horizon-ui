{
    "name": "@cialdnb/horizon-ui",
    "version": "0.0.1",
    "description": "Horizon DS React component library (shadcn + Tailwind v4)",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./styles.unlayered.css": "./dist/styles.unlayered.css",
        "./tokens": {
            "types": "./dist/tokens/index.d.ts",
            "import": "./dist/tokens/index.js"
        },
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons/index.js"
        },
        "./illustrations": {
            "types": "./dist/illustrations/index.d.ts",
            "import": "./dist/illustrations/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "@cialdnb:registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p coexistence",
        "lint": "eslint .",
        "test": "vitest run",
        "storybook": "storybook dev -p 6006",
        "build:tokens": "tsx scripts/build-tokens.ts",
        "build:mcp-manifest": "echo \"build:mcp-manifest is implemented in a later task\" && exit 1",
        "build-storybook": "storybook build",
        "test:coexistence": "playwright test",
        "port-illustrations": "tsx scripts/port-illustrations.ts",
        "usage-report": "tsx scripts/usage-report.ts",
        "usage-map": "tsx scripts/usage-map.ts"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^9.39.5",
        "@mui/material": "^5.18.0",
        "@playwright/test": "^1.64.1",
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/addon-vitest": "^10.6.5",
        "@storybook/react-vite": "^10.6.5",
        "@tailwindcss/node": "4.3.3",
        "@tailwindcss/oxide": "4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser": "^4.1.12",
        "@vitest/browser-playwright": "^4.1.12",
        "bootstrap": "^4.4.1",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^5.4.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "jsdom": "^29.1.1",
        "lint-staged": "^16.4.0",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "^10.6.5",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0"
    },
    "engines": {
        "node": ">=20.19"
    }
}
